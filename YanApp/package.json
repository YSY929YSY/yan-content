{
  "name": "yanapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev:client:lan": "expo start --dev-client -c --port 8081 --lan",
    "dev:tunnel": "expo start --dev-client -c --port 8081 --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test --test-reporter=spec \"src/**/__tests__/*.test.mjs\" \"src/**/__tests__/*.test.ts\"",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "expo start --dev-client --lan",
    "dev:clean": "expo start --dev-client -c --lan"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.108.2",
    "d3-geo": "^3.1.1",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.8.3",
    "svg-path-properties": "^2.0.2",
    "topojson-client": "^3.1.0"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  }
}
